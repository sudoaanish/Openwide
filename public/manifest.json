{
  "manifest_version": 3,
  "name": "Openwide — Fit, Elastic & Ambient",
  "version": "0.1.1",
  "icons": {
    "16": "icons/openwide-16.png",
    "32": "icons/openwide-32.png",
    "48": "icons/openwide-48.png",
    "128": "icons/openwide-128.png"
  },
  "minimum_chrome_version": "116",
  "description": "Fit videos to your screen with automatic black-bar detection, center-preserving Elastic Stretch, and fullscreen ambience.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/openwide-16.png",
      "32": "icons/openwide-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Openwide controls"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Toggle video controls"
    },
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Cycle fitting modes"
    },
    "reset-video": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Reset current video"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/openwide-logo.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
